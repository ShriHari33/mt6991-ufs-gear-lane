From: Shrihari Hampiholi <shrihari@hampiholi.com>
Subject: [PATCH] ufs: mediatek: add gear_lane sysfs for power mode change

Add /sys/.../16810000.ufshci/gear_lane to change UFS HS gear and lane
count at run time. ufs_mtk_config_gear_lane() follows the same sequence
as ufs_mtk_config_pwr_mode() (W-LUN resume, block requests, hold clocks,
drain doorbells, ufs_sel mux ordering around G5), plus host_sem.

Against MTK kernel_device_modules-6.6 (the public MT6991 copy); apply with
-p1 from the kernel_device_modules-6.6 root. Not compiled.

---
diff -ruN a/drivers/ufs/ufs-mediatek.c b/drivers/ufs/ufs-mediatek.c
--- a/drivers/ufs/ufs-mediatek.c	2026-10-31 12:51:36.351829831 +0530
+++ b/drivers/ufs/ufs-mediatek.c	2026-10-31 12:51:36.351829831 +0530
@@ -2361,6 +2361,101 @@
 	__pm_relax(host->ufs_wake_lock);
 }
 
+int ufs_mtk_config_gear_lane(struct ufs_hba *hba, u32 gear, u32 lane)
+{
+	struct ufs_mtk_host *host = ufshcd_get_variant(hba);
+	struct ufs_pa_layer_attr pwr_info;
+	ktime_t timeout, time_checked;
+	bool scale_allow, to_g5;
+	int err;
+
+	if (gear < UFS_HS_G1 || gear > hba->max_pwr_info.info.gear_rx ||
+	    lane < 1 || lane > hba->max_pwr_info.info.lane_rx)
+		return -EINVAL;
+
+	/* same condition ufs_mtk_dynamic_clock_scaling() uses */
+	scale_allow = hba->dev_info.wspecversion >= 0x0400 &&
+		      ((host->caps & UFS_MTK_CAP_CLK_SCALE_ONLY_BY_USER) ||
+		       hba->clk_scaling.is_initialized);
+	to_g5 = gear >= UFS_HS_G5;
+
+	memcpy(&pwr_info, &hba->pwr_info, sizeof(pwr_info));
+	pwr_info.gear_rx = pwr_info.gear_tx = gear;
+	pwr_info.lane_rx = pwr_info.lane_tx = lane;
+	/* anything else makes MTK's negotiation send an all-zero PMC */
+	pwr_info.pwr_rx = pwr_info.pwr_tx = FAST_MODE;
+
+	/* serialize with the error handler and other UFS sysfs writers */
+	down(&hba->host_sem);
+	if (!ufshcd_is_user_access_allowed(hba)) {
+		err = -EBUSY;
+		goto unlock;
+	}
+
+	__pm_stay_awake(host->ufs_wake_lock);
+
+	/* make sure pm resume done */
+	timeout = ktime_add_ms(ktime_get(), UFS_WAKE_LOCK_TIMEOUT_MS);
+	do {
+		time_checked = ktime_get();
+
+		/* Wait until suspend flow exit */
+		if (pm_suspend_target_state == PM_SUSPEND_ON)
+			goto rpm;
+
+		usleep_range(100, 200);
+	} while (ktime_before(time_checked, timeout));
+
+	dev_warn(hba->dev, "Wait suspend status timeout, status = %d\n",
+		 pm_suspend_target_state);
+	err = -EBUSY;
+	goto relax;
+rpm:
+	/* resume the device W-LUN: link out of hibern8, UniPro up, AHIT back */
+	ufshcd_rpm_get_sync(hba);
+	ufs_mtk_scsi_block_requests(hba);
+	/* no clock gating from here on */
+	ufshcd_hold(hba);
+
+	err = ufs_mtk_wait_for_doorbell_clr(hba, 1000 * 1000); /* 1 sec */
+	if (err) {
+		dev_err(hba->dev, "%s: ufshcd_wait_for_doorbell_clr timeout!\n",
+			__func__);
+		goto out;
+	}
+
+	/* G5 needs ufs_sel at max (and vcore up) before the PMC */
+	if (to_g5 && scale_allow) {
+		ufs_mtk_pm_qos(hba, true);
+		_ufs_mtk_clk_scale(hba, true);
+	}
+
+	err = ufshcd_config_pwr_mode(hba, &pwr_info);
+
+	/* AH8 disable failed in PRE_CHANGE: a host reset is already queued */
+	if (!err && hba->ufshcd_state != UFSHCD_STATE_OPERATIONAL)
+		err = -EIO;
+
+	/* lower the clock only once the link is really below G5 */
+	if (!err && !to_g5 && scale_allow) {
+		ufs_mtk_pm_qos(hba, false);
+		_ufs_mtk_clk_scale(hba, false);
+	}
+
+	dev_info(hba->dev, "%s: err=%d [RX, TX]: gear=[%d, %d], lane=[%d, %d]\n",
+		 __func__, err, hba->pwr_info.gear_rx, hba->pwr_info.gear_tx,
+		 hba->pwr_info.lane_rx, hba->pwr_info.lane_tx);
+out:
+	ufshcd_release(hba);
+	ufs_mtk_scsi_unblock_requests(hba);
+	ufshcd_rpm_put(hba);
+relax:
+	__pm_relax(host->ufs_wake_lock);
+unlock:
+	up(&hba->host_sem);
+	return err;
+}
+
 void ufs_mtk_dynamic_clock_scaling(struct ufs_hba *hba, int mode)
 {
 	struct ufs_mtk_host *host = ufshcd_get_variant(hba);
diff -ruN a/drivers/ufs/ufs-mediatek.h b/drivers/ufs/ufs-mediatek.h
--- a/drivers/ufs/ufs-mediatek.h	2026-10-31 12:51:36.351829831 +0530
+++ b/drivers/ufs/ufs-mediatek.h	2026-10-31 12:51:36.351829831 +0530
@@ -409,6 +409,7 @@
 };
 
 void ufs_mtk_dynamic_clock_scaling(struct ufs_hba *hba, int mode);
+int ufs_mtk_config_gear_lane(struct ufs_hba *hba, u32 gear, u32 lane);
 
 /**
  * ufshcd_upiu_wlun_to_scsi_wlun - maps UPIU W-LUN id to SCSI W-LUN ID
diff -ruN a/drivers/ufs/ufs-mediatek-sysfs.c b/drivers/ufs/ufs-mediatek-sysfs.c
--- a/drivers/ufs/ufs-mediatek-sysfs.c	2026-10-31 12:51:36.351829831 +0530
+++ b/drivers/ufs/ufs-mediatek-sysfs.c	2026-10-31 12:51:36.351829831 +0530
@@ -1035,12 +1035,40 @@
 	return count;
 }
 
+static ssize_t gear_lane_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct ufs_hba *hba = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "gear rx/tx %u/%u lane rx/tx %u/%u\n",
+			  hba->pwr_info.gear_rx, hba->pwr_info.gear_tx,
+			  hba->pwr_info.lane_rx, hba->pwr_info.lane_tx);
+}
+
+static ssize_t gear_lane_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct ufs_hba *hba = dev_get_drvdata(dev);
+	u32 gear, lane;
+	int err;
+
+	if (sscanf(buf, "%u %u", &gear, &lane) != 2)
+		return -EINVAL;
+
+	err = ufs_mtk_config_gear_lane(hba, gear, lane);
+
+	return err ? err : count;
+}
+
+static DEVICE_ATTR_RW(gear_lane);
+
 static DEVICE_ATTR_RW(skip_blocktag);
 static DEVICE_ATTR_RW(dbg_tp_unregister);
 
 static struct attribute *ufs_mtk_sysfs_attrs[] = {
 	&dev_attr_skip_blocktag.attr,
 	&dev_attr_dbg_tp_unregister.attr,
+	&dev_attr_gear_lane.attr,
 	NULL
 };
 
